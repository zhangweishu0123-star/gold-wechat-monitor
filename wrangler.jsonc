{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gold-wechat-monitor",
  "main": "index.js",
  "compatibility_date": "2026-08-10",

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "GOLD_STATE",
        "class_name": "GoldState"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GoldState"]
    }
  ],

  "vars": {
    "START_HOLDINGS_G": "675.5714",
    "START_CASH_YUAN": "80000",
    "CORE_FLOOR_G": "575",
    "CASH_FLOOR_YUAN": "25000",
    "SELL_FEE_RATE": "0.004",
    "MAX_QUOTE_AGE_MINUTES": "15",
    "RETRY_MINUTES": "30"
  }
}
